# GitHub's linguist counts raw bytes of tracked text files, so a 29 MB
# generated C parser outweighs the entire Go engine (3 MB) — the repo showed
# as "C 94% / Go 4%". Files carrying these attributes are excluded from the
# language statistics (and from diffs where noted).
#
# Vendored tree-sitter grammars: generated by tree-sitter-cli from a grammar.js,
# rebuilt only when a grammar is upgraded. Never hand-edited.
#
# The `-diff` marking is scoped to the VENDORED grammar directories only. It
# used to cover `internal/tstree/**`, which also swept in the hand-written
# extractor source beside them (tstree.go, calls.go and the tests) — so a real
# change to the extractor was shown by git as "Binary files differ" and could
# not be reviewed. The grammar directories are the generated part; the .go
# files next to them are ours and stay diffable.
internal/tstree/dart/** linguist-generated=true
internal/tstree/dart/** -diff
internal/tstree/objc/** linguist-generated=true
internal/tstree/objc/** -diff
internal/tstree/perl/** linguist-generated=true
internal/tstree/perl/** -diff
internal/tstree/** linguist-generated=true

# Built dashboard assets checked in so the Go binary can `embed` them
# (`make go-ui-assets` regenerates them from ui-v2).
internal/web/embed/** linguist-generated=true

# Third-party minified bundle served by the dashboard.
**/vis-network.min.js linguist-vendored=true

# Indexing fixtures (deliberately weird source in many languages).
internal/index/testdata/** linguist-vendored=true
