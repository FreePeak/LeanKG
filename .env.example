# LeanKG environment reference. Copy to .env (git-ignored) and export the values
# you need: the binaries read the process environment and do not load this file.
# Every value here is an example or a placeholder; put real secrets only in .env.

# --- Storage ---------------------------------------------------------------
# sqlite (default, zero config) | postgres (needs LEANKG_PG_URL)
LEANKG_DB_ENGINE=sqlite
# PostgreSQL DSN, used only with LEANKG_DB_ENGINE=postgres
# LEANKG_PG_URL=postgres://<user>:<password>@<host>:5432/<database>?sslmode=require

# --- Embeddings: provider and identity -------------------------------------
# local (llama.cpp sidecar or attached endpoint) | openai (OpenAI-compatible) | deterministic (tests)
LEANKG_EMBED_PROVIDER=local
# Catalog id or provider model name, e.g. embeddinggemma-2 (see "Embedding providers" in README.md)
# LEANKG_EMBED_MODEL=embeddinggemma-2
# Attach to a running OpenAI-compatible endpoint instead of spawning a sidecar
# LEANKG_EMBED_BASE_URL=http://127.0.0.1:8080/v1
# Bearer token for a remote endpoint; leave empty for a local sidecar
LEANKG_EMBED_API_KEY=
# Vector width; empty = the catalog width. Matryoshka truncation for embeddinggemma-2: 512, 256 or 128
# LEANKG_EMBED_DIMS=
# Explicit model revision; overrides the catalog pin and invalidates the collection when changed
# LEANKG_EMBED_REVISION=

# --- Embeddings: local llama.cpp sidecar -----------------------------------
# Executable (default llama-server, release b11454 or newer for embeddinggemma-2)
LEANKG_EMBED_SIDECAR_CMD=llama-server
# Shell-quoted argv. Empty = the built-in bge-small-en-v1.5 GGUF. Example for embeddinggemma-2:
# LEANKG_EMBED_SIDECAR_ARGS="-m /path/to/embeddinggemma-2-BF16.gguf --embeddings --pooling mean -c 8192 -b 8192 -ub 8192 --parallel 1"
# Port the sidecar listens on (default 8080)
LEANKG_EMBED_SIDECAR_PORT=8080
# Seconds to wait for the sidecar's /health (default 120)
LEANKG_EMBED_SIDECAR_READY_SECS=120

# --- Hook (SessionStart: leankg index --hook) ------------------------------
# Skip hook indexing above this many indexable files (default 10000)
LEANKG_HOOK_MAX_FILES=10000
# Skip hook embedding above this many elements needing vectors (default 500)
LEANKG_HOOK_MAX_EMBED=500

# --- EmbeddingGemma 2 + Hugging Face Job (scripts/hf-embed.sh only) ---------
# Bulk embedding runs on a Hugging Face Job; queries and hook backlogs stay local.
# Private Storage Bucket that holds the sentence-transformers model files and the exported texts
LEANKG_HF_BUCKET=<your-org>/<your-bucket>
# Path of the model inside the bucket (default: the bucket root)
LEANKG_HF_MODEL_DIR=
# Work prefix inside the bucket for exports and results (default: leankg)
LEANKG_HF_WORK_DIR=leankg
# Hugging Face Jobs hardware flavor, one of the priced set: cpu-basic, cpu-upgrade, t4-small, t4-medium, l4x1, a10g-small, a10g-large (default: l4x1)
LEANKG_HF_JOB_FLAVOR=l4x1
# Job timeout as N, Ns, Nm or Nh; the timeout bounds the billed time (default: 30m)
LEANKG_HF_JOB_TIMEOUT=30m
# Budget in USD: a run whose worst case (timeout x hourly price) exceeds this is refused (default: 0.50)
LEANKG_HF_MAX_USD=0.50
# Assumed texts per second for the estimate, until measured with --limit 200 (default: 50)
LEANKG_HF_EST_RATE=50
# Assumed minutes of job startup and dependency install, added to the estimate (default: 6)
LEANKG_HF_EST_OVERHEAD_MIN=6
# hf CLI executable (default: hf)
HF_BIN=hf
# leankg-embed executable for export and import (default: leankg-embed); scripts/hf-embed.sh also reads
# LEANKG_EMBED_MODEL (default: embeddinggemma-2) and LEANKG_EMBED_BASE_URL (export needs a running sidecar)
LEANKG_EMBED_BIN=leankg-embed
# Hugging Face token, read by the hf CLI itself (hf-embed.sh never prints it). Empty = use `hf auth login` instead. Never commit a real value.
HF_TOKEN=
