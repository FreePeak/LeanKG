# Embedder worker image. Uses the locally-built embed-enabled binary
# (target/release/leankg with --features=embeddings). Built in two stages:
# the binary is copied into a non-`target/` path so .dockerignore doesn't
# exclude it, then copied into the runtime image.
FROM debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        libssl3 \
        libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY .docker-build/leankg /usr/local/bin/leankg

# Default embed profile: quality (FP32, full 512-token window). Fast
# (INT8 / 128-token) is opt-in via LEANKG_EMBED_FAST=1 + LEANKG_EMBED_MAX_SEQ=128.
ENV LEANKG_INSERT_BATCH_SIZE=20000

CMD ["leankg", "embed", "--wait", "--project", "/workspace"]
